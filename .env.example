# YouTube Data API v3
# Create a server-side API key in Google Cloud and add the same value in Vercel.
YOUTUBE_API_KEY=

# Optional overrides. The site defaults to @TheHomeBasePH and resolves the channel with forHandle.
YOUTUBE_HANDLE=@TheHomeBasePH
YOUTUBE_CHANNEL_ID=

# Optional: if you already know the channel's uploads playlist ID, set it here.
# When present, the site skips playlist discovery but still reads channel stats.
YOUTUBE_UPLOADS_PLAYLIST_ID=
